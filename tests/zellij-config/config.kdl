// The zellij configuration that test runs use. ZELLIJ_CONFIG_DIR points at it.
//
// The existence of this file is the point. With no configuration file at all,
// zellij opens its first run setup wizard. The wizard swallows the screen and
// every keystroke that a test sends. This file keeps the stock keybindings, so
// <C-q> quits and <C-p> enters pane mode exactly as the documentation says.
//
// A test run does not use the configuration of the developer. A test must not
// change its result because someone rebound a key or picked a different theme.

// The startup tip pane and the release note pane open over the layout. Every
// dump then catches these panes first.
show_startup_tips false
show_release_notes false

theme "default"
default_mode "normal"
pane_frames true
mouse_mode false
copy_on_select false
