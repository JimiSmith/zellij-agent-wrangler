# This test starts a real zellij with no custom layout. The test waits for the
# status bar of zellij, dumps the screen and reaps the session.
#
# ZELLIJ_CONFIG_DIR points at tests/zellij-config, which is in the repository.
# The run therefore gets stock keybindings and a known theme, and not the
# configuration of the developer. No first run wizard appears.
#
# `wrangler-test-smoke` is the only session name here, and it carries the
# prefix that cleanup can match.

env: ZELLIJ_CONFIG_DIR=tests/zellij-config
env: TERM=xterm-256color

spawn: zellij --session wrangler-test-smoke

# The stock status bar names the modifier its keybindings hang off.
wait: Ctrl @ 20
waitgone: First Run Setup Wizard @ 2

# A shell can give the default tab a title wider than the stock tab bar.
sh: zellij --session wrangler-test-smoke action rename-tab smoke
wait: wrangler-test-smoke @ 20
dump: zellij_smoke

# Ctrl-q is the stock quit binding. Cleanup can reap the session in any case,
# but a quit first leaves nothing to force.
keys: <C-q>
sleep: 1
