# One call for the user raises one desktop notification. The number of sidebars
# that hold the call makes no difference. A flurry of calls raises one
# notification between them.
#
# The test opens a second tab, so that the session has two sidebars. A sidebar
# that raises its own notification is visible only as a count. Both sidebars
# draw the same row and say the same words. The difference is the number of runs
# of the notifier.
#
# The notifier writes a line to a file and does not reach the desktop, so the
# run stays silent and countable. The test reports the calls from the host and
# names a pane, rather than types the calls into a pane. The count has nothing
# to do with where the agent is. The daemon is what announces, and the daemon
# knows nothing of panes.

env: ZELLIJ_CONFIG_DIR=$PWD/tests/zellij-config
env: TERM=xterm-256color
env: XDG_STATE_HOME=$PWD/tests/out/state
env: XDG_CACHE_HOME=$PWD/tests/out/cache

sh?: tests/scripts/reset.sh wrangler-test-notify
sh?: rm -f tests/out/raised.log

sh: cargo build --target wasm32-wasip1 -p zellij-agent-wrangler
sh: cargo build -p agent-wrangler
sh: tests/scripts/make-layout.sh tests/out/notify.kdl $PWD/tests/scripts/record-notification.sh

spawn: zellij --session wrangler-test-notify --new-session-with-layout tests/out/notify.kdl

wait: notes @ 25

# A second tab, from the same template, with a sidebar of its own. Ctrl-t is
# the stock tab mode, and n opens a tab.
keys: <C-t>
keys: n
sleep: 2

sh: tests/scripts/expect-raised.sh 0

sh: tests/scripts/raise-call.sh notify-one wrangler-test-notify 1 needsAttention
sleep: 2

# One call, two sidebars, one notification.
sh: tests/scripts/expect-raised.sh 1

# If a call arrives while the last call is still recent, the call is not a
# second interruption. The reset above started the daemon fresh, so the call
# before this one began the quiet. Nothing that an earlier run left behind began
# the quiet.
sh: tests/scripts/raise-call.sh notify-one wrangler-test-notify 1 needsAttention
sleep: 2
sh: tests/scripts/expect-raised.sh 1

# After the quiet runs out, the daemon announces a call again. The count
# therefore measures calls, and not a notifier that runs only one time. The wait
# starts from the call that the daemon announced. A call that the daemon passed
# over does not put the next call further off.
sleep: 5
sh: tests/scripts/raise-call.sh notify-one wrangler-test-notify 1 needsAttention
sleep: 2
sh: tests/scripts/expect-raised.sh 2

# An agent that goes back to work is not something to announce.
sh: tests/scripts/raise-call.sh notify-one wrangler-test-notify 1 working
sleep: 2
sh: tests/scripts/expect-raised.sh 2

dump: notification_once

keys: <C-q>
sleep: 1
