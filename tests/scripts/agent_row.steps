# The whole path, end to end. A hook fires from inside a real pane and reaches
# the daemon. The daemon pipes the state into the zellij session. The sidebar
# draws that session as a row.
#
# The test types the hook into a pane, and does not run it on the host. The pane
# is the source of `ZELLIJ_PANE_ID`, and that variable alone decides which row
# the agent lands under.

env: ZELLIJ_CONFIG_DIR=$PWD/tests/zellij-config
env: TERM=xterm-256color
env: XDG_STATE_HOME=$PWD/tests/out/state
env: XDG_CACHE_HOME=$PWD/tests/out/cache
# The daemon socket is named for the user. Without a name of its own, a run
# reports to the daemon of the client that the developer installed.
env: USER=wrangler-test

# If an interrupted run leaves a session behind, this run fails to start rather
# than fails an assertion. A daemon left over from another run holds records
# that this run did not make.
sh?: tests/scripts/reset.sh wrangler-test-e2e

sh: cargo build --target wasm32-wasip1 -p zellij-agent-wrangler
sh: cargo build -p agent-wrangler
sh: tests/scripts/make-layout.sh tests/out/e2e.kdl

spawn: zellij --session wrangler-test-e2e --new-session-with-layout tests/out/e2e.kdl

# The sidebar draws the tabs of the session. The name of its own tab is the
# first proof that the sidebar is alive and got the permissions that it asked
# for.
wait: notes @ 25

# This is what the hook of a real agent does, from the pane that a real agent
# runs in.
keys: printf '%s' '{"session_id":"e2e-one","cwd":"/home/u/quarry","transcript_path":"'"$PWD"'/tests/out/e2e-transcript.jsonl"}' | "$PWD/target/debug/agent-wrangler" hook claude start\r

# This records what the pane saw of its own environment and of the hook. This
# record is the only way to tell a hook that never ran from a hook that ran but
# was not delivered.
keys: echo "PANE zellij=$ZELLIJ session=$ZELLIJ_SESSION_NAME pane=$ZELLIJ_PANE_ID" > tests/out/pane-env.txt 2>&1\r
sleep: 1
sh?: sh -c 'sleep 1; ./target/debug/agent-wrangler agents > tests/out/agents.txt 2>&1'

# Deliver by hand. This tells a sink that was never registered from a message
# that the sidebar does not act on.

# This is the label that the transcript gives the session. If the label appears
# at all, the hook reached the daemon and the daemon reached this session. The
# plugin also put the record under the pane that the hook named.
wait: QUARRYMARK @ 20
dump: agent_row_start

# The user already sits in the pane that raises the call, so the call is
# answered where it lands. The proof that the call travelled is the daemon,
# which agrees that the call was answered. Nothing on the screen proves it.
keys: printf '%s' '{"session_id":"e2e-one","cwd":"/home/u/quarry","transcript_path":"'"$PWD"'/tests/out/e2e-transcript.jsonl"}' | "$PWD/target/debug/agent-wrangler" hook claude needsAttention\r
sleep: 3
sh: tests/scripts/expect-turn.sh e2e-one idle
dump: agent_row_answered

keys: <C-q>
sleep: 1
