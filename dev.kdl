// The layout that `dev.sh` runs the prototype under.
//
// Only the first tab has a sidebar. If the user goes to a tab without one,
// that tab gets a sidebar from the sidebars that already run. The tab template
// therefore carries the tab bar and the status bar, exactly like the default
// layout of zellij.
//
// PLUGIN_LOCATION takes the absolute path of the built wasm. A `file:` location
// resolves against the cwd of the session and not against this file.
//
// CLIENT_LOCATION takes the absolute path of the built client. The value must be
// a path and not `on`. `on` means that the client is on `$PATH`, and a
// development build is not. The sidebar runs that client to reach the daemon. If
// the sidebar cannot find the name, it draws no agents and gives no reason.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="PLUGIN_LOCATION" {
                    // Every option. Both templates carry the same block,
                    // because a later tab takes its configuration from its own
                    // template.
                    //
                    // Three of these are not at their default value. The client
                    // has no default path. The status line and the desktop
                    // notification are off by default, and a development
                    // session turns both on so that they can be judged by eye.
                    label "name"
                    sections false
                    dashboard false
                    turn_state true
                    notifications true
                    status_line "{branch} · {model} · {context_tokens}"
                    desktop_notification "on"
                    install_hooks "CLIENT_LOCATION"
                }
            }
            children
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="PLUGIN_LOCATION" {
                    // Every option. Both templates carry the same block,
                    // because a later tab takes its configuration from its own
                    // template.
                    //
                    // Three of these are not at their default value. The client
                    // has no default path. The status line and the desktop
                    // notification are off by default, and a development
                    // session turns both on so that they can be judged by eye.
                    label "name"
                    sections false
                    dashboard false
                    turn_state true
                    notifications true
                    status_line "{branch} · {model} · {context_tokens}"
                    desktop_notification "off"
                    install_hooks "CLIENT_LOCATION"
                }
            }
            pane
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    // A tab for judging the dashboard by eye. The template draws the tree in
    // the sidebar on its left, so both views draw one session side by side.
    //
    // The shell pane is where a developer starts an agent. Without it the tab
    // opens on a plugin pane, which takes no keys.
    tab name="dashboard" focus=true {
        pane split_direction="vertical" {
            pane {
                plugin location="PLUGIN_LOCATION" {
                    // Only what differs from the block above. Every other
                    // option keeps its default, which is what a reader of this
                    // tab wants to see the dashboard drawn with.
                    dashboard true
                    install_hooks "CLIENT_LOCATION"
                }
            }
            pane size=32 focus=true
        }
    }
    tab name="wrangler" {
        pane
    }
    tab name="notes" {
        pane
    }
}
