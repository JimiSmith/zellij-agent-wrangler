// The layout `dev.sh` runs the prototype under.
//
// Only the first tab is given a sidebar. A tab without one gets a sidebar from
// the sidebars already running, the moment the user goes to it, so the tab
// template carries the tab bar and the status bar exactly as zellij's own
// default layout does.
//
// PLUGIN_LOCATION is substituted for the built wasm's absolute path: a `file:`
// location is resolved against the session's cwd rather than against this file.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="wrangler" focus=true {
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="PLUGIN_LOCATION"
            }
            pane
        }
    }
    tab name="notes" {
        pane
    }
}
