// The layout `dev.sh` runs the prototype under.
//
// Only the first tab is given a sidebar. A tab without one gets a sidebar from
// the sidebars already running, the moment the user goes to it, so the tab
// template carries the tab bar and the status bar exactly as zellij's own
// default layout does.
//
// PLUGIN_LOCATION is substituted for the built wasm's absolute path: a `file:`
// location is resolved against the session's cwd rather than against this file.
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="PLUGIN_LOCATION" {
                    // Every option, at its default. Both templates carry the
                    // same block: a tab opened later is configured by the one
                    // it is built from.
                    label "name"
                    sections false
                    turn_state true
                    notifications true
                    desktop_notification "on"
                    install_hooks "on"
                }
            }
            children
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    new_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        pane split_direction="vertical" {
            pane size=32 borderless=true {
                plugin location="PLUGIN_LOCATION" {
                    // Every option, at its default. Both templates carry the
                    // same block: a tab opened later is configured by the one
                    // it is built from.
                    label "name"
                    sections false
                    turn_state true
                    notifications true
                    desktop_notification "off"
                    install_hooks "off"
                }
            }
            pane
        }
        pane size=1 borderless=true {
            plugin location="zellij:status-bar"
        }
    }
    tab name="wrangler" focus=true {
        pane
    }
    tab name="notes" {
        pane
    }
}
